generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrganizationType {
  MUNICIPIO
  GENERADOR
  RECOLECTOR
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum MemberRole {
  ADMIN_MUNICIPIO
  OPERADOR_GENERADOR
  OPERADOR_RECOLECTOR
}

enum UnitType {
  KG
  TON
}

enum LotStatus {
  PUBLISHED
  ASSIGNED
  COLLECTED
  CLOSED
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  RELEASED
  COMPLETED
}

enum OperationStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  CLOSED
}

enum EvidenceType {
  PHOTO
  DOCUMENT
}

enum CertificateStatus {
  ISSUED
  ANCHORED
  VERIFIED
  ERROR
}

enum AnchorStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum HashAlgorithm {
  SHA256
}

enum AuditEntityType {
  LOT
  OPERATION
  CERTIFICATE
}

model User {
  id          String                @id @default(uuid())
  email       String                @unique
  passwordHash String               @map("password_hash")
  fullName    String                @map("full_name")
  phone       String?
  status      UserStatus            @default(ACTIVE)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  memberships OrganizationMember[]

  @@map("users")
}

model Organization {
  id          String                @id @default(uuid())
  type        OrganizationType
  legalName   String                @map("legal_name")
  displayName String                @map("display_name")
  taxId       String?               @map("tax_id")
  address     String
  lat         Float?
  lng         Float?
  status      OrganizationStatus    @default(ACTIVE)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  members         OrganizationMember[]
  generatedLots   Lot[]                @relation("GeneratorLots")
  assignedLots    LotAssignment[]       @relation("CollectorAssignments")
  operations      Operation[]           @relation("CollectorOperations")

  @@map("organizations")
}

model OrganizationMember {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  userId         String        @map("user_id")
  role           MemberRole

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model WasteType {
  id       String   @id @default(uuid())
  code     String   @unique
  name     String
  unit     UnitType
  active   Boolean  @default(true)

  lots Lot[]

  @@map("waste_types")
}

model Lot {
  id                  String      @id @default(uuid())
  publicCode          String      @unique @map("public_code")
  generatorOrgId      String      @map("generator_org_id")
  wasteTypeId         String      @map("waste_type_id")
  estimatedQuantityKg Float       @map("estimated_quantity_kg")
  address             String
  lat                 Float?
  lng                 Float?
  pickupWindowStart   DateTime    @map("pickup_window_start")
  pickupWindowEnd     DateTime    @map("pickup_window_end")
  notes               String?
  status              LotStatus   @default(PUBLISHED)
  createdBy           String      @map("created_by")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  generator  Organization   @relation("GeneratorLots", fields: [generatorOrgId], references: [id])
  wasteType   WasteType      @relation(fields: [wasteTypeId], references: [id])
  assignments LotAssignment[]
  operation   Operation?

  @@index([status, createdAt])
  @@index([generatorOrgId, createdAt])
  @@map("lots")
}

model LotAssignment {
  id            String           @id @default(uuid())
  lotId         String           @map("lot_id")
  collectorOrgId String          @map("collector_org_id")
  assignedBy    String           @map("assigned_by")
  assignedAt    DateTime         @default(now()) @map("assigned_at")
  status        AssignmentStatus @default(ACTIVE)

  lot       Lot          @relation(fields: [lotId], references: [id])
  collector Organization @relation("CollectorAssignments", fields: [collectorOrgId], references: [id])

  @@index([collectorOrgId, assignedAt])
  @@map("lot_assignments")
}

model Operation {
  id                         String          @id @default(uuid())
  lotId                      String          @unique @map("lot_id")
  collectorOrgId             String          @map("collector_org_id")
  collectedQuantityKg        Float           @map("collected_quantity_kg")
  collectedAt                DateTime        @map("collected_at")
  confirmedByGeneratorUserId String?        @map("confirmed_by_generator_user_id")
  closedByUserId             String?         @map("closed_by_user_id")
  closedAt                   DateTime?       @map("closed_at")
  status                     OperationStatus @default(PENDING_CONFIRMATION)
  createdAt                  DateTime        @default(now()) @map("created_at")
  updatedAt                  DateTime        @updatedAt @map("updated_at")

  lot       Lot            @relation(fields: [lotId], references: [id])
  collector Organization   @relation("CollectorOperations", fields: [collectorOrgId], references: [id])
  evidences OperationEvidence[]
  certificate Certificate?

  @@index([status, createdAt])
  @@map("operations")
}

model OperationEvidence {
  id         String       @id @default(uuid())
  operationId String      @map("operation_id")
  fileUrl    String       @map("file_url")
  fileType   EvidenceType @map("file_type")
  uploadedBy String       @map("uploaded_by")
  uploadedAt DateTime     @default(now()) @map("uploaded_at")

  operation Operation @relation(fields: [operationId], references: [id])

  @@map("operation_evidences")
}

model Certificate {
  id                     String            @id @default(uuid())
  operationId            String            @unique @map("operation_id")
  certificateNumber      String            @unique @map("certificate_number")
  publicVerificationCode String            @unique @map("public_verification_code")
  pdfUrl                 String            @map("pdf_url")
  issuedAt               DateTime          @default(now()) @map("issued_at")
  status                 CertificateStatus @default(ISSUED)

  operation Operation         @relation(fields: [operationId], references: [id])
  anchor    BlockchainAnchor?

  @@map("certificates")
}

model BlockchainAnchor {
  id            String       @id @default(uuid())
  certificateId String       @unique @map("certificate_id")
  network       String
  hashAlgorithm HashAlgorithm @default(SHA256) @map("hash_algorithm")
  payloadHash   String       @map("payload_hash")
  txId          String?      @map("tx_id")
  anchoredAt    DateTime?    @map("anchored_at")
  status        AnchorStatus @default(PENDING)
  errorMessage  String?      @map("error_message")

  certificate Certificate @relation(fields: [certificateId], references: [id])

  @@map("blockchain_anchors")
}

model AuditEvent {
  id         String          @id @default(uuid())
  entityType AuditEntityType @map("entity_type")
  entityId   String          @map("entity_id")
  eventType  String          @map("event_type")
  payloadJson Json           @map("payload_json")
  createdBy  String?         @map("created_by")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@map("audit_events")
}
